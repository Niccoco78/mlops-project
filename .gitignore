# Environnement local
.venv/
.env

# Donnees, modeles et suivi MLflow : produits par `make data` / `make train`,
# jamais versionnes.
data/*
!data/.gitkeep
artifacts/*
!artifacts/.gitkeep
mlruns/
mlartifacts/
mlflow.db

# Les predictions contiennent les lignes du jeu de donnees : on garde les
# courbes et les metriques dans reports/, pas les CSV.
reports/*.csv

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# OS / IDE
.DS_Store
.vscode/
.idea/
