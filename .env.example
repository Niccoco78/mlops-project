# Copier ce fichier en .env et adapter si besoin.
# Les variables d'environnement priment sur configs/config.yaml.

# Backend MLflow. SQLite est necessaire pour le Model Registry.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=churn-exp

# Pipeline charge par l'API (service/app.py)
MODEL_PATH=artifacts/model.joblib
